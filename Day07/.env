# RustRent configuration.
#
# Every variable below is optional: the service starts with none of them set,
# and the values shown here are the defaults. Set them to change that behavior.
#
# The service does NOT load this file by itself. Export it into your shell:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   cargo run

# SQLite database. Relative paths resolve from the working directory. The file
# is created if missing, and migrations run at startup.
DATABASE_URL=sqlite://rust_rent.db

# Log filter for the JSON logs on stdout, in EnvFilter syntax.
# Example: info,rust_rent=debug
RUST_LOG=info

# Reported on traces as deployment.environment.name.
DEPLOYMENT_ENV=local

# Reported on traces as service.name.
OTEL_SERVICE_NAME=reservation-api

# OTLP/HTTP collector base URL; /v1/traces is appended automatically.
# Only http/protobuf is compiled in, so use the HTTP port (4318), not gRPC (4317).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional: headers for an authenticated collector. Treat the value as a secret.
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>

# Optional: sample a share of traces in production. Everything is sampled by default.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
